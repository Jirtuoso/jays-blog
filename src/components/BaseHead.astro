---
import siteConfig from '@/site-config'
import '@/styles/global.css'
import '@/styles/prose.css'
import '@/styles/dot.css'

interface Props {
  title?: string
  description?: string
  image?: { src: string; alt?: string }
  pageType?: 'website' | 'article'
  noindex?: boolean
}

const {
  description = siteConfig.description,
  image = siteConfig.image,
  pageType = 'website',
  noindex = false,
} = Astro.props

const title = Astro.props.title
  ? `${Astro.props.title} | ${siteConfig.title}`
  : `${siteConfig.title} | Personal Website & Writing`

const resolvedImage = image?.src
  ? {
      src: new URL(image.src, Astro.site).toString(),
      alt: image.alt,
    }
  : undefined

const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString()
---

<!-- High Priority Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>{title}</title>
<meta name="author" content={siteConfig.author} />

<!-- Low Priority Global Metadata -->
<link rel="icon" type="image/png" href="/toad-icon.png" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="alternate" type="application/rss+xml" href="/rss.xml" title="RSS" />

<!-- Page Metadata -->
<link rel="canonical" href={canonicalURL} />
<meta name="description" content={description} />
{noindex && <meta name="robots" content="noindex" />}

<!-- Open Graph / Facebook -->
<meta property="og:type" content={pageType} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:site_name" content={siteConfig.title} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{resolvedImage?.src && <meta property="og:image" content={resolvedImage.src} />}
{
  resolvedImage?.alt && (
    <meta property="og:image:alt" content={resolvedImage.alt} />
  )
}

<!-- X / Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonicalURL} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
{
  resolvedImage?.src && (
    <meta property="twitter:image" content={resolvedImage.src} />
  )
}
{
  resolvedImage?.alt && (
    <meta name="twitter:image:alt" content={resolvedImage?.alt} />
  )
}

<script is:inline>
  // New visits start dark; retain a light-mode choice while this tab is open.
  const preferredTheme = sessionStorage.getItem('jay-site-theme')
  document.documentElement.classList.toggle('dark', preferredTheme !== 'light')
</script>

<script>
  import nprogress from 'nprogress'

  document.addEventListener('astro:before-preparation', () => {
    nprogress.start()
  })

  document.addEventListener('astro:page-load', () => {
    nprogress.done()
  })
</script>
