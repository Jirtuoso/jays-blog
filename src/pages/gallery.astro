---
import BaseLayout from '@/layouts/BaseLayout.astro'
import gallery from '@/data/gallery.json'

const photos = gallery.photos
---

<BaseLayout
  title="Gallery"
  description="A photo gallery by Jay Hou: landscapes, city views, and moments from his travels."
  image={{ src: photos[0].src, alt: photos[0].alt }}
  wide
>
  <section class="gallery-page">
    <h1 class="sr-only">{gallery.title}</h1>

    <div class="gallery-grid">
      {
        photos.map((photo, index) => (
          <figure class="gallery-item">
            <a
              href={photo.source || photo.src}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`View ${photo.caption}${photo.source ? ' on VSCO' : ''}`}
            >
              <img
                src={photo.src}
                alt={photo.alt}
                width={photo.width}
                height={photo.height}
                loading={index < 3 ? 'eager' : 'lazy'}
                decoding="async"
                fetchpriority={index === 0 ? 'high' : undefined}
              />
            </a>
            <figcaption>{photo.caption}</figcaption>
          </figure>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .gallery-page {
    --gallery-muted: #58645d;
    --gallery-line: rgba(21, 55, 39, 0.2);
    max-width: 100%;
    padding-bottom: 4rem;
  }

  :global(.dark) .gallery-page {
    --gallery-muted: #b5c7ba;
    --gallery-line: rgba(238, 244, 235, 0.25);
  }

  .gallery-item {
    margin: 0;
  }

  .gallery-item a {
    display: block;
    overflow: hidden;
    background: var(--gallery-line);
  }

  .gallery-item img {
    display: block;
    height: auto;
    width: 100%;
    border-radius: 0;
    transition:
      transform 450ms ease,
      filter 450ms ease;
  }

  .gallery-item a:hover img {
    transform: scale(1.025);
    filter: saturate(1.08);
  }

  .gallery-item figcaption {
    color: var(--gallery-muted);
    font-size: 0.8rem;
    letter-spacing: 0.02em;
    line-height: 1.4;
    margin-top: 0.6rem;
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2.5rem 1.25rem;
    align-items: start;
  }

  @media (max-width: 800px) {
    .gallery-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .gallery-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.25rem 0.75rem;
    }
  }

  @media (max-width: 420px) {
    .gallery-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .gallery-item img {
      transition: none;
    }
  }
</style>
