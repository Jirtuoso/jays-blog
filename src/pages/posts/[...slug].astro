---
import BaseLayout from '@/layouts/BaseLayout.astro'
import { type CollectionPosts } from '@/types'
import { getPosts } from '@/utils/posts'

export async function getStaticPaths() {
  const posts = await getPosts()
  return posts.map((post) => {
    return {
      params: { slug: post.slug },
      props: {
        post,
      },
    }
  })
}

type Props = { post: CollectionPosts }

const { post } = Astro.props
const { title, image, description, date } = post.data

const { Content } = await post.render()
const siteURL = Astro.site?.toString() ?? Astro.url.origin

function getDate(date: string) {
  return new Date(date).toISOString()
}
const articleData = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description: description,
  url: new URL(`/posts/${post.slug}/`, Astro.site).toString(),
  datePublished: date ? getDate(date) : undefined,
  author: {
    '@type': 'Person',
    '@id': `${siteURL}#person`,
    name: 'Jay Hou',
    url: siteURL,
  },
  image: image ? new URL(image.src, Astro.site).toString() : undefined,
}
---

<BaseLayout title={title} description={description} pageType="article">
  <script type="application/ld+json" set:html={JSON.stringify(articleData)} />
  <article class="prose">
    <h1>{title}</h1>
    {
      image && (
        <p>
          <img width="640" height="360" src={image.src} alt={image.alt || ''} />
        </p>
      )
    }
    <Content />
  </article>
</BaseLayout>
