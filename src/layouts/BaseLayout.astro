---
import { fade } from 'astro:transitions'
import { ViewTransitions } from 'astro:transitions'
import BaseHead from '@/components/BaseHead.astro'
import Header from '@/components/Header.vue'
import Footer from '@/components/Footer.vue'
import ScrollToTop from '@/components/ScrollToTop.vue'
import UmamiAnalytics from '@/components/UmamiAnalytics.astro' // Add this line

const { wide = false, ...head } = Astro.props
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <BaseHead {...head} />
    <ViewTransitions />
  </head>
  <body class="bg-main text-main min-h-screen font-sans w-full bg-dot">
    <Header client:load />
    <main
      class:list={[
        'grow mx-auto sm:pt-36 pt-26 pb-6 px-6 relative',
        wide ? 'max-w-6xl' : 'max-w-3xl',
      ]}
      transition:animate={fade({ duration: '0.4s' })}
    >
      <slot />
      <ScrollToTop client:load />
      <Footer />
      <UmamiAnalytics />
    </main>
  </body>
</html>
